		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>SiftBundledServerVersion</key>
	<string>$(MARKETING_VERSION)</string>
	<key>SUFeedURL</key>
	<string>https://sift.weisssolutions.org/appcast.xml</string>
